---
/** A terminal window drawn in HTML, for showing commands and their output. */
interface Props {
  title?: string
}
const { title = 'zsh' } = Astro.props
---

<figure class="overflow-hidden rounded-xl border border-line bg-panel shadow-2xl shadow-black/40">
  <figcaption class="flex items-center gap-2 border-b border-line bg-panel2 px-4 py-2.5 text-xs text-muted">
    <span class="size-2.5 rounded-full bg-[#ff5f57]"></span>
    <span class="size-2.5 rounded-full bg-[#febc2e]"></span>
    <span class="size-2.5 rounded-full bg-[#28c840]"></span>
    <span class="ml-2 font-mono">{title}</span>
  </figcaption>
  <pre class="overflow-x-auto px-5 py-4 font-mono text-[13px] leading-6 text-text"><slot /></pre>
</figure>
